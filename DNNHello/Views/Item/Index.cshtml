@inherits DotNetNuke.Web.Mvc.Framework.DnnWebViewPage<IEnumerable<DNNHello.DNNHello.Models.Item>>

@using System.Web.Mvc
@using System.Web.Mvc.Html
@using DotNetNuke.Framework.JavaScriptLibraries

@{
    JavaScript.RequestRegistration(CommonJs.jQuery);
    JavaScript.RequestRegistration(CommonJs.DnnPlugins);
    DotNetNuke.Framework.ServicesFramework.Instance.RequestAjaxScriptSupport();

    var globalItems = ViewBag.GlobalItems as IEnumerable<DNNHello.DNNHello.Models.Item>
                      ?? Enumerable.Empty<DNNHello.DNNHello.Models.Item>();
    bool isAdmin = ViewBag.IsAdmin ?? false;
    int currentUserId = ViewBag.CurrentUserId ?? -1;
}

<style>
    /* ═══ KÁRTYA ═══ */
    .pp-card {
        position: relative;
        background: #fff;
        border: 1px solid #e8e8e8;
        border-radius: 10px;
        overflow: visible;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        margin-bottom: 10px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        cursor: pointer;
    }

        .pp-card:hover {
            transform: translateY(-6px) scale(1.02);
            box-shadow: 0 12px 28px rgba(0,0,0,0.15);
        }

    /* ═══ ADMIN KÁRTYA – bordó alj ═══ */
    .pp-card-admin {
        border-color: #d4a0a8;
    }

        .pp-card-admin .pp-card-title {
            background: linear-gradient(135deg, #8b2d3a 0%, #a94455 100%);
            color: #fff;
            border-radius: 0 0 10px 10px;
        }

        .pp-card-admin:hover .pp-card-title {
            color: #fff !important;
        }

    /* ═══ KÉP ZOOM ═══ */
    .pp-card-img-wrap {
        width: 100%;
        aspect-ratio: 1 / 1;
        overflow: hidden;
        background: #f5f5f5;
        border-radius: 10px 10px 0 0;
    }

    .pp-card-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.4s ease;
    }

    .pp-card:hover .pp-card-img {
        transform: scale(1.08);
    }

    /* ═══ TÖRLÉS GOMB ═══ */
    .pp-del-btn {
        position: absolute;
        bottom: -10px;
        right: -8px;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        border: 2px solid #fff;
        background: #dc3545;
        color: #fff;
        font-size: 14px;
        font-weight: bold;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        line-height: 1;
        box-shadow: 0 2px 6px rgba(0,0,0,0.25);
        z-index: 10;
        transition: transform 0.25s ease, background 0.25s ease;
        opacity: 0.85;
    }

        .pp-del-btn:hover {
            transform: scale(1.3) rotate(90deg);
            background: #a71d2a;
            box-shadow: 0 4px 14px rgba(220,53,69,0.5);
            opacity: 1;
        }

    /* ═══ CÍM ═══ */
    .pp-card-title {
        padding: 8px 10px;
        font-size: 0.9em;
        font-weight: 500;
        color: #333;
        text-align: center;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        transition: color 0.3s ease, background 0.3s ease;
    }

    .pp-card:hover .pp-card-title {
        color: #8b2d3a;
    }

    /* ═══ FELTÖLTÉS GOMB ═══ */
    .pp-upload-btn {
        padding: 10px 24px;
        background: #8b2d3a;
        color: #fff;
        border: none;
        border-radius: 6px;
        font-size: 0.95em;
        font-weight: 600;
        cursor: pointer;
        white-space: nowrap;
        transition: background 0.3s ease, transform 0.2s ease, box-shadow 0.3s ease;
    }

        .pp-upload-btn:hover {
            background: #6e2430;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(139,45,58,0.4);
        }

    /* ═══ NINCS KÉP ═══ */
    .pp-card-noimg {
        width: 100%;
        aspect-ratio: 1 / 1;
        background: #f0f0f0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.5em;
        color: #ccc;
        border-radius: 10px 10px 0 0;
    }

    /* ═══ MODAL GOMBOK ═══ */
    .pp-modal-yes {
        padding: 10px 20px;
        background: #dc3545;
        color: #fff;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        font-weight: 600;
        transition: background 0.2s ease, transform 0.2s ease;
    }

        .pp-modal-yes:hover {
            background: #a71d2a;
            transform: translateY(-2px);
        }

    .pp-modal-no {
        padding: 10px 20px;
        background: #e0e0e0;
        color: #333;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        font-weight: 600;
        transition: background 0.2s ease, transform 0.2s ease;
    }

        .pp-modal-no:hover {
            background: #c0c0c0;
            transform: translateY(-2px);
        }

    /* ═══ INPUT ═══ */
    .pp-name-input {
        width: 100%;
        padding: 10px 14px;
        border: 1px solid #ccc;
        border-radius: 6px;
        font-size: 0.95em;
        outline: none;
        box-sizing: border-box;
        transition: border-color 0.3s ease, box-shadow 0.3s ease;
    }

        .pp-name-input:focus {
            border-color: #8b2d3a;
            box-shadow: 0 0 0 3px rgba(139,45,58,0.15);
        }

    /* ═══ FÁJLVÁLASZTÓ LABEL ═══ */
    .pp-file-label {
        display: inline-block;
        padding: 8px 16px;
        background: #fff;
        border: 1px solid #ccc;
        border-radius: 6px;
        cursor: pointer;
        font-size: 0.9em;
        color: #555;
        transition: border-color 0.3s ease, background 0.2s ease;
    }

        .pp-file-label:hover {
            border-color: #8b2d3a;
            background: #fdf0f2;
        }

    /* ═══ CSILLAG GOMB ═══ */
    .pp-star-btn {
        position: absolute;
        top: 8px;
        right: 8px;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background: rgba(200, 200, 200, 0.7);
        border: none;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        z-index: 10;
        transition: background 0.3s ease, transform 0.2s ease;
        padding: 0;
        line-height: 1;
    }

        .pp-star-btn:hover {
            transform: scale(1.15);
        }

        .pp-star-btn.active {
            background: rgba(255, 193, 7, 0.9);
        }

        .pp-star-btn .star-icon {
            color: #999;
            transition: color 0.3s ease;
        }

        .pp-star-btn.active .star-icon {
            color: #fff;
        }

        .pp-star-btn.readonly {
            cursor: default;
            pointer-events: none;
        }

    /* ═══ USER ENGEDÉLYEZÉS GOMB ═══ */
    .pp-approve-btn {
        position: absolute;
        bottom: -10px;
        left: -8px;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background: rgba(200, 200, 200, 0.8);
        border: 2px solid #fff;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 10;
        transition: background 0.3s ease, transform 0.2s ease;
        padding: 0;
        box-shadow: 0 2px 6px rgba(0,0,0,0.2);
    }

        .pp-approve-btn:hover {
            transform: scale(1.15);
        }

        .pp-approve-btn .inner-circle {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background: #999;
            transition: background 0.3s ease;
        }

        .pp-approve-btn.active {
            background: #2196F3;
        }

            .pp-approve-btn.active .inner-circle {
                background: #fff;
            }

        .pp-approve-btn.readonly {
            cursor: default;
            pointer-events: none;
        }

    /* ═══ KIEMELT KÉPEK GALÉRIA ═══ */
    .pp-global-section {
        margin-bottom: 28px;
        padding: 20px 22px;
        background: #fff;
        border: 2px solid #e8c4ca;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(139,45,58,0.08);
        position: relative;
    }

    .pp-global-title {
        font-size: 1.15em;
        font-weight: 700;
        color: #8b2d3a;
        margin-bottom: 14px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .pp-global-title::after {
            content: '';
            flex: 1;
            height: 1px;
            background: linear-gradient(90deg, #e8c4ca 0%, transparent 100%);
            margin-left: 8px;
        }

    .pp-global-section .pp-card {
        border: 1px solid #f0dce0;
        background: #fff;
        box-shadow: 0 2px 10px rgba(139,45,58,0.06);
    }

        .pp-global-section .pp-card:hover {
            box-shadow: 0 8px 28px rgba(139,45,58,0.12);
            border-color: #d4a0a8;
        }

    .pp-global-section .pp-card-title {
        color: #555;
    }

    .pp-global-section .pp-card:hover .pp-card-title {
        color: #8b2d3a;
    }

    .pp-global-empty {
        text-align: center;
        color: #b88a92;
        padding: 20px 0;
        font-size: 0.95em;
        font-style: italic;
    }

    /* ═══ BEVEZETŐ SZEKCIÓ ═══ */
    .pp-intro-section {
        margin-bottom: 20px;
        padding: 16px 20px;
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        border: 1px solid #dee2e6;
        border-radius: 12px;
    }

    .pp-intro-title {
        font-size: 1.15em;
        font-weight: 700;
        color: #8b2d3a;
        margin-bottom: 8px;
    }

    .pp-intro-text {
        font-size: 0.92em;
        color: #555;
        line-height: 1.6;
        margin: 0;
    }

    .pp-intro-legend {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        margin-top: 12px;
        padding-top: 10px;
        border-top: 1px solid #dee2e6;
    }

    .pp-legend-item {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 0.85em;
        color: #666;
    }

    .pp-legend-icon {
        width: 22px;
        height: 22px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        flex-shrink: 0;
    }

    .pp-legend-star {
        background: rgba(255, 193, 7, 0.9);
        color: #fff;
    }

    .pp-legend-approve {
        background: #2196F3;
    }

    .pp-legend-approve-inner {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #fff;
    }

    .pp-legend-delete {
        background: #dc3545;
        color: #fff;
        font-weight: bold;
        font-size: 10px;
    }

    /* ═══ BEJELENTKEZÉS SZEKCIÓ ═══ */
    .pp-login-section {
        padding: 24px 28px;
        background: linear-gradient(135deg, #fdf0f2 0%, #f9e0e5 100%);
        border: 1px solid #e8c4ca;
        border-radius: 12px;
        text-align: center;
    }

    .pp-login-icon {
        font-size: 2em;
        margin-bottom: 8px;
    }

    .pp-login-title {
        font-size: 1.1em;
        font-weight: 700;
        color: #8b2d3a;
        margin-bottom: 6px;
    }

    .pp-login-text {
        font-size: 0.95em;
        color: #7a4a53;
        margin: 0;
        line-height: 1.5;
    }

    /* ═══ LIGHTBOX ═══ */
    .pp-lightbox {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.85);
        z-index: 100000;
        align-items: center;
        justify-content: center;
        cursor: pointer;
    }

        .pp-lightbox.active {
            display: flex;
        }

        .pp-lightbox img {
            max-width: 90vw;
            max-height: 85vh;
            border-radius: 12px;
            box-shadow: 0 8px 40px rgba(0,0,0,0.5);
            object-fit: contain;
            cursor: default;
        }

    .pp-lightbox-title {
        position: absolute;
        bottom: 30px;
        left: 50%;
        transform: translateX(-50%);
        color: #fff;
        font-size: 1.1em;
        font-weight: 600;
        background: rgba(0,0,0,0.5);
        padding: 8px 20px;
        border-radius: 20px;
    }

    .pp-lightbox-close {
        position: absolute;
        top: 20px;
        right: 30px;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: rgba(255,255,255,0.15);
        border: none;
        color: #fff;
        font-size: 22px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background 0.2s ease, transform 0.2s ease;
    }

        .pp-lightbox-close:hover {
            background: rgba(255,255,255,0.3);
            transform: scale(1.1);
        }

    /* ═══ RESZPONZÍV ═══ */
    @@media (max-width: 768px) {
        .pp-gallery-grid {
            grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)) !important;
            gap: 12px !important;
        }

        .pp-intro-legend {
            flex-direction: column;
            gap: 8px;
        }
    }

    @@media (max-width: 480px) {
        .pp-gallery-grid {
            grid-template-columns: repeat(2, 1fr) !important;
            gap: 10px !important;
        }
    }
</style>

<div style="padding:15px 20px; width:100%; box-sizing:border-box;">

    @* ═══ KIEMELT KÉPEK (mindig látható) ═══ *@
    <div class="pp-global-section">
        <div class="pp-global-title">★ Kiemelt Képek</div>
        @if (globalItems.Any())
        {
            <div class="pp-gallery-grid" style="display:grid; grid-template-columns:repeat(auto-fill, minmax(180px, 1fr)); gap:18px;">
                @foreach (var gItem in globalItems)
                {
                    <div class="pp-card" onclick="ppOpenLightbox('@Html.Raw(gItem.ImagePath)', '@Html.Raw(gItem.ItemName.Replace("'", "\\'"))')">
                        @if (!string.IsNullOrEmpty(gItem.ImagePath))
                        {
                            <div class="pp-card-img-wrap">
                                <img src="@gItem.ImagePath" alt="@gItem.ItemName" class="pp-card-img" />
                            </div>
                        }
                        else
                        {
                            <div class="pp-card-noimg">🖼️</div>
                        }
                        <div class="pp-card-title">@gItem.ItemName</div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="pp-global-empty">Még nincsenek kiemelt képek.</div>
        }
    </div>

    @if (Dnn.User.UserID == -1)
    {
        @* ═══ NEM BEJELENTKEZETT NÉZET ═══ *@
        <div class="pp-login-section">
            <div class="pp-login-icon">📸</div>
            <div class="pp-login-title">Szeretnél te is képeket feltölteni?</div>
            <p class="pp-login-text">
                Jelentkezz be, hogy saját képeidet is feltölthesd a galériába!<br />
                A legjobb képek bekerülhetnek a Kiemelt Képek közé.
            </p>
        </div>
    }
    else
    {
        @* ═══ BEVEZETŐ ═══ *@
        <div class="pp-intro-section">
            <div class="pp-intro-title">📸 Képgaléria</div>
            <p class="pp-intro-text">
                Itt láthatod a saját feltöltött képeidet. Ha szeretnéd, hogy valamelyik képed
                bekerüljön a <strong>Kiemelt Képek</strong> közé, engedélyezd a megosztását
                a kék gombbal. Az admin ezután kiválaszthatja a legjobbakat.
                Kattints bármelyik képre a nagyított megtekintéshez!
            </p>
            <div class="pp-intro-legend">
                <div class="pp-legend-item">
                    <span class="pp-legend-icon pp-legend-star">★</span>
                    <span>Admin kijelölte kiemeltnek</span>
                </div>
                <div class="pp-legend-item">
                    <span class="pp-legend-icon pp-legend-approve"><span class="pp-legend-approve-inner"></span></span>
                    <span>Megosztás engedélyezve</span>
                </div>
                <div class="pp-legend-item">
                    <span class="pp-legend-icon pp-legend-delete">✕</span>
                    <span>Kép törlése</span>
                </div>
            </div>
        </div>

        @* ═══ FELTÖLTŐ SÁV ═══ *@
        <div style="background:#f9f9f9; border:1px solid #e0e0e0; border-radius:10px; padding:14px 18px; margin-bottom:24px;">
            <table style="width:100%; border:none; border-collapse:collapse; background:transparent;">
                <tr>
                    <td style="padding:0 10px 0 0; border:none; background:transparent;">
                        <input type="text"
                               id="ppName_@Dnn.ModuleContext.ModuleId"
                               placeholder="Kép neve..."
                               class="pp-name-input" />
                    </td>
                    <td style="padding:0 10px 0 0; border:none; background:transparent; white-space:nowrap;">
                        <label class="pp-file-label" id="ppFileLabel_@Dnn.ModuleContext.ModuleId">
                            📁 Kép kiválasztása
                            <input type="file"
                                   id="ppFile_@Dnn.ModuleContext.ModuleId"
                                   accept="image/*"
                                   style="display:none;" />
                        </label>
                        <span id="ppFileName_@Dnn.ModuleContext.ModuleId" style="margin-left:8px; font-size:0.88em; color:#888;">Nincs kiválasztva fájl</span>
                    </td>
                    <td style="padding:0; border:none; background:transparent; white-space:nowrap; text-align:right;">
                        <button type="button"
                                id="ppUploadBtn_@Dnn.ModuleContext.ModuleId"
                                class="pp-upload-btn">
                            ⬆ Feltöltés
                        </button>
                    </td>
                </tr>
            </table>
            <div id="ppStatus_@Dnn.ModuleContext.ModuleId" style="display:none; margin-top:8px; font-size:0.9em; color:#666;"></div>
        </div>

        @* ═══ SZEMÉLYES GALÉRIA ═══ *@
        <div class="pp-gallery-grid" style="display:grid; grid-template-columns:repeat(auto-fill, minmax(180px, 1fr)); gap:18px; padding-bottom:15px;">

            @if (Model == null || !Model.Any())
            {
                <p style="grid-column:1/-1; text-align:center; color:#999; padding:40px 0;">
                    Még nincs feltöltött képed a galériában.
                </p>
            }
            else
            {
                foreach (var item in Model)
                {
                    bool isOwner = item.CreatedByUserId == currentUserId;
                    bool isAdminUpload = isAdmin && isOwner;

                    <div class="pp-card @(isAdminUpload ? "pp-card-admin" : "")" id="ppCard_@item.ItemId">
                        @if (!string.IsNullOrEmpty(item.ImagePath))
                        {
                            <div class="pp-card-img-wrap" onclick="ppOpenLightbox('@Html.Raw(item.ImagePath)', '@Html.Raw(item.ItemName.Replace("'", "\\'"))')">
                                <img src="@item.ImagePath" alt="@item.ItemName" class="pp-card-img" />
                            </div>
                        }
                        else
                        {
                            <div class="pp-card-noimg">🖼️</div>
                        }

                        @* ── CSILLAG ── *@
                        @if (isAdmin)
                        {
                            <button type="button"
                                    class="pp-star-btn @(item.IsGlobal ? "active" : "")"
                                    onclick="ppToggleStar(@item.ItemId, this); event.stopPropagation();"
                                    title="Kiemelt képek közé helyezés">
                                <span class="star-icon">★</span>
                            </button>
                        }
                        else if (item.IsGlobal)
                        {
                            <span class="pp-star-btn active readonly" title="Kiemelt képek között szerepel">
                                <span class="star-icon">★</span>
                            </span>
                        }

                        @* ── USER ENGEDÉLYEZÉS ── *@
                        @if (isOwner)
                        {
                            <button type="button"
                                    class="pp-approve-btn @(item.IsUserApproved ? "active" : "")"
                                    onclick="ppToggleApproval(@item.ItemId, this); event.stopPropagation();"
                                    title="@(item.IsUserApproved ? "Megosztás engedélyezve" : "Megosztás engedélyezése")">
                                <span class="inner-circle"></span>
                            </button>
                        }
                        else if (isAdmin)
                        {
                            <span class="pp-approve-btn @(item.IsUserApproved ? "active" : "") readonly"
                                  title="@(item.IsUserApproved ? "Felhasználó engedélyezte" : "Felhasználó még nem engedélyezte")">
                                <span class="inner-circle"></span>
                            </span>
                        }

                        <div class="pp-card-title">@item.ItemName</div>

                        <button type="button"
                                class="pp-del-btn"
                                onclick="ppDel(@item.ItemId, '@Html.Raw(item.ItemName.Replace("'", "\\'"))'); event.stopPropagation();">
                            ✕
                        </button>
                    </div>
                }
            }
        </div>
    }
</div>

@* ═══ TÖRLÉS MODAL ═══ *@
<div id="ppDelModal"
     style="display:none; position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,0.5); z-index:99999; align-items:center; justify-content:center;">
    <div style="background:#fff; padding:30px; border-radius:12px; box-shadow:0 5px 30px rgba(0,0,0,0.3); text-align:center; max-width:400px; width:90%;">
        <p style="font-size:1.1em; margin-bottom:5px;"><strong>Törlés megerősítése</strong></p>
        <p>Biztosan törölni szeretnéd?</p>
        <p id="ppDelName" style="font-weight:bold; color:#dc3545;"></p>
        <div style="margin-top:20px; display:flex; gap:10px; justify-content:center;">
            <button type="button" onclick="ppExecDel()" class="pp-modal-yes">Igen, törlöm</button>
            <button type="button" onclick="ppCloseDel()" class="pp-modal-no">Mégse</button>
        </div>
    </div>
</div>

@* ═══ LIGHTBOX ═══ *@
<div id="ppLightbox" class="pp-lightbox" onclick="ppCloseLightbox()">
    <button class="pp-lightbox-close" onclick="ppCloseLightbox()" title="Bezárás">✕</button>
    <img id="ppLightboxImg" src="" alt="" onclick="event.stopPropagation();" />
    <div id="ppLightboxTitle" class="pp-lightbox-title"></div>
</div>

<script type="text/javascript">
    (function ($) {
        var mid = '@Dnn.ModuleContext.ModuleId';
        var sf = $.ServicesFramework(parseInt(mid));
        var delId = null;

        // ═══ FÁJLNÉV MEGJELENÍTÉS (magyar) ═══
        $('#ppFile_' + mid).on('change', function () {
            var fileName = this.files && this.files.length > 0 ? this.files[0].name : 'Nincs kiválasztva fájl';
            $('#ppFileName_' + mid).text(fileName);
        });

        // ═══ FELTÖLTÉS ═══
        $('#ppUploadBtn_' + mid).on('click', function () {
            var nameInput = document.getElementById('ppName_' + mid);
            var fileInput = document.getElementById('ppFile_' + mid);
            var statusDiv = document.getElementById('ppStatus_' + mid);

            var itemName = nameInput.value.trim();
            if (!itemName) {
                alert('Kérlek, add meg a kép nevét!');
                nameInput.focus();
                return;
            }

            if (!fileInput.files || fileInput.files.length === 0) {
                alert('Kérlek, válassz ki egy képet!');
                return;
            }

            var formData = new FormData();
            formData.append('ItemName', itemName);
            formData.append('ModuleId', mid);
            formData.append('file', fileInput.files[0]);

            var apiUrl = sf.getServiceRoot('DNNHello') + 'GalleryApi/Upload';

            statusDiv.style.display = 'block';
            statusDiv.innerText = 'Feltöltés folyamatban...';

            $.ajax({
                url: apiUrl,
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                beforeSend: sf.setModuleHeaders,
                success: function () {
                    statusDiv.innerText = 'Sikeres feltöltés! Oldal frissítése...';
                    location.reload();
                },
                error: function (xhr) {
                    statusDiv.style.color = '#dc3545';
                    statusDiv.innerText = 'Hiba történt a feltöltés során. (' + xhr.status + ')';
                }
            });
        });

        // ═══ CSILLAG TOGGLE ═══
        window.ppToggleStar = function (itemId, btn) {
            var apiUrl = sf.getServiceRoot('DNNHello') + 'GalleryApi/ToggleGlobal?itemId=' + itemId;
            $.ajax({
                url: apiUrl,
                type: 'POST',
                beforeSend: sf.setModuleHeaders,
                success: function (data) {
                    if (data.isGlobal) {
                        $(btn).addClass('active');
                    } else {
                        $(btn).removeClass('active');
                    }
                },
                error: function (xhr) {
                    alert('Hiba a kijelölés során. (' + xhr.status + ')');
                }
            });
        };

        // ═══ USER ENGEDÉLYEZÉS TOGGLE ═══
        window.ppToggleApproval = function (itemId, btn) {
            var apiUrl = sf.getServiceRoot('DNNHello') + 'GalleryApi/ToggleUserApproval?itemId=' + itemId;
            $.ajax({
                url: apiUrl,
                type: 'POST',
                beforeSend: sf.setModuleHeaders,
                success: function (data) {
                    if (data.isUserApproved) {
                        $(btn).addClass('active');
                    } else {
                        $(btn).removeClass('active');
                    }
                },
                error: function (xhr) {
                    alert('Hiba az engedélyezés során. (' + xhr.status + ')');
                }
            });
        };

        // ═══ LIGHTBOX ═══
        window.ppOpenLightbox = function (imgPath, imgName) {
            document.getElementById('ppLightboxImg').src = imgPath;
            document.getElementById('ppLightboxImg').alt = imgName;
            document.getElementById('ppLightboxTitle').innerText = imgName;
            document.getElementById('ppLightbox').classList.add('active');
            document.body.style.overflow = 'hidden';
        };

        window.ppCloseLightbox = function () {
            document.getElementById('ppLightbox').classList.remove('active');
            document.getElementById('ppLightboxImg').src = '';
            document.body.style.overflow = '';
        };

        // ═══ TÖRLÉS ═══
        window.ppDel = function (id, name) {
            delId = id;
            document.getElementById('ppDelName').innerText = '"' + name + '"';
            document.getElementById('ppDelModal').style.display = 'flex';
        };

        window.ppCloseDel = function () {
            delId = null;
            document.getElementById('ppDelModal').style.display = 'none';
        };

        window.ppExecDel = function () {
            if (delId !== null) {
                window.location.href = '@Url.Action("Delete", "Item")' + '?itemId=' + delId;
            }
        };

        $(document).on('keydown', function (e) {
            if (e.key === 'Escape') {
                ppCloseLightbox();
                ppCloseDel();
            }
        });

    }(jQuery));
</script>
