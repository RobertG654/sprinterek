@inherits DotNetNuke.Web.Mvc.Framework.DnnWebViewPage<IEnumerable<DNNHello.DNNHello.Models.Item>>

@using System.Web.Mvc
@using System.Web.Mvc.Html
@using DotNetNuke.Framework.JavaScriptLibraries

@{
    JavaScript.RequestRegistration(CommonJs.jQuery);
    JavaScript.RequestRegistration(CommonJs.DnnPlugins);
    DotNetNuke.Framework.ServicesFramework.Instance.RequestAjaxScriptSupport();

    var globalItems = ViewBag.GlobalItems as IEnumerable<DNNHello.DNNHello.Models.Item>
                      ?? Enumerable.Empty<DNNHello.DNNHello.Models.Item>();
    bool isAdmin = ViewBag.IsAdmin ?? false;
    int currentUserId = ViewBag.CurrentUserId ?? -1;
}

<style>
    /* ═══ KÁRTYA ═══ */
    .pp-card {
        position: relative;
        background: #fff;
        border: 1px solid #e8e8e8;
        border-radius: 10px;
        overflow: visible;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        margin-bottom: 10px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        cursor: pointer;
    }

        .pp-card:hover {
            transform: translateY(-6px) scale(1.02);
            box-shadow: 0 12px 28px rgba(0,0,0,0.15);
        }

    /* ═══ KÉP ZOOM ═══ */
    .pp-card-img-wrap {
        width: 100%;
        aspect-ratio: 1 / 1;
        overflow: hidden;
        background: #f5f5f5;
        border-radius: 10px 10px 0 0;
    }

    .pp-card-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.4s ease;
    }

    .pp-card:hover .pp-card-img {
        transform: scale(1.08);
    }

    /* ═══ TÖRLÉS GOMB ═══ */
    .pp-del-btn {
        position: absolute;
        bottom: -10px;
        right: -8px;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        border: 2px solid #fff;
        background: #dc3545;
        color: #fff;
        font-size: 14px;
        font-weight: bold;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        line-height: 1;
        box-shadow: 0 2px 6px rgba(0,0,0,0.25);
        z-index: 10;
        transition: transform 0.25s ease, background 0.25s ease;
        opacity: 0.85;
    }

        .pp-del-btn:hover {
            transform: scale(1.3) rotate(90deg);
            background: #a71d2a;
            box-shadow: 0 4px 14px rgba(220,53,69,0.5);
            opacity: 1;
        }

    /* ═══ CÍM ═══ */
    .pp-card-title {
        padding: 8px 10px;
        font-size: 0.9em;
        font-weight: 500;
        color: #333;
        text-align: center;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        transition: color 0.3s ease;
    }

    .pp-card:hover .pp-card-title {
        color: #8b2d3a;
    }

    /* ═══ FELTÖLTÉS GOMB ═══ */
    .pp-upload-btn {
        padding: 10px 24px;
        background: #8b2d3a;
        color: #fff;
        border: none;
        border-radius: 6px;
        font-size: 0.95em;
        font-weight: 600;
        cursor: pointer;
        white-space: nowrap;
        transition: background 0.3s ease, transform 0.2s ease, box-shadow 0.3s ease;
    }

        .pp-upload-btn:hover {
            background: #6e2430;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(139,45,58,0.4);
        }

    /* ═══ NINCS KÉP ═══ */
    .pp-card-noimg {
        width: 100%;
        aspect-ratio: 1 / 1;
        background: #f0f0f0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.5em;
        color: #ccc;
        border-radius: 10px 10px 0 0;
    }

    /* ═══ MODAL ═══ */
    .pp-modal-yes {
        padding: 10px 20px;
        background: #dc3545;
        color: #fff;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        font-weight: 600;
        transition: background 0.2s ease, transform 0.2s ease;
    }

        .pp-modal-yes:hover {
            background: #a71d2a;
            transform: translateY(-2px);
        }

    .pp-modal-no {
        padding: 10px 20px;
        background: #e0e0e0;
        color: #333;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        font-weight: 600;
        transition: background 0.2s ease, transform 0.2s ease;
    }

        .pp-modal-no:hover {
            background: #c0c0c0;
            transform: translateY(-2px);
        }

    /* ═══ INPUT ═══ */
    .pp-name-input {
        width: 100%;
        padding: 10px 14px;
        border: 1px solid #ccc;
        border-radius: 6px;
        font-size: 0.95em;
        outline: none;
        box-sizing: border-box;
        transition: border-color 0.3s ease, box-shadow 0.3s ease;
    }

        .pp-name-input:focus {
            border-color: #8b2d3a;
            box-shadow: 0 0 0 3px rgba(139,45,58,0.15);
        }

    /* ═══ CSILLAG GOMB (jobb felső sarok) ═══ */
    .pp-star-btn {
        position: absolute;
        top: 8px;
        right: 8px;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background: rgba(200, 200, 200, 0.7);
        border: none;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        z-index: 10;
        transition: background 0.3s ease, transform 0.2s ease;
        padding: 0;
        line-height: 1;
    }

        .pp-star-btn:hover {
            transform: scale(1.15);
        }

        .pp-star-btn.active {
            background: rgba(255, 193, 7, 0.9);
        }

        .pp-star-btn .star-icon {
            color: #999;
            transition: color 0.3s ease;
        }

        .pp-star-btn.active .star-icon {
            color: #fff;
        }

        .pp-star-btn.readonly {
            cursor: default;
            pointer-events: none;
        }

    /* ═══ USER ENGEDÉLYEZÉS GOMB (bal alsó sarok) ═══ */
    .pp-approve-btn {
        position: absolute;
        bottom: -10px;
        left: -8px;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background: rgba(200, 200, 200, 0.8);
        border: 2px solid #fff;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 10;
        transition: background 0.3s ease, transform 0.2s ease;
        padding: 0;
        box-shadow: 0 2px 6px rgba(0,0,0,0.2);
    }

        .pp-approve-btn:hover {
            transform: scale(1.15);
        }

        .pp-approve-btn .inner-circle {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background: #999;
            transition: background 0.3s ease;
        }

        .pp-approve-btn.active {
            background: #2196F3;
        }

            .pp-approve-btn.active .inner-circle {
                background: #fff;
            }

        .pp-approve-btn.readonly {
            cursor: default;
            pointer-events: none;
        }

    /* ═══ GLOBÁLIS GALÉRIA ═══ */
    .pp-global-section {
        margin-bottom: 30px;
        padding: 22px 24px;
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
        border: none;
        border-radius: 16px;
        box-shadow: 0 8px 32px rgba(0,0,0,0.18), inset 0 1px 0 rgba(255,255,255,0.05);
        position: relative;
        overflow: hidden;
    }

        .pp-global-section::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle at 30% 40%, rgba(255,193,7,0.08) 0%, transparent 50%), radial-gradient(circle at 70% 60%, rgba(100,149,237,0.06) 0%, transparent 50%);
            pointer-events: none;
        }

    .pp-global-title {
        font-size: 1.2em;
        font-weight: 700;
        color: #ffc107;
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        gap: 10px;
        text-shadow: 0 1px 4px rgba(0,0,0,0.3);
        position: relative;
        z-index: 1;
    }

        .pp-global-title::after {
            content: '';
            flex: 1;
            height: 1px;
            background: linear-gradient(90deg, rgba(255,193,7,0.4) 0%, transparent 100%);
            margin-left: 8px;
        }

    .pp-global-section .pp-card {
        border: 1px solid rgba(255,255,255,0.1);
        background: rgba(255,255,255,0.06);
        box-shadow: 0 4px 16px rgba(0,0,0,0.2);
    }

        .pp-global-section .pp-card:hover {
            box-shadow: 0 12px 36px rgba(255,193,7,0.15);
            border-color: rgba(255,193,7,0.3);
        }

    .pp-global-section .pp-card-title {
        color: #e0e0e0;
    }

    .pp-global-section .pp-card:hover .pp-card-title {
        color: #ffc107;
    }

    /* ═══ BEVEZETŐ SZEKCIÓ ═══ */
    .pp-intro-section {
        margin-bottom: 20px;
        padding: 16px 20px;
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        border: 1px solid #dee2e6;
        border-radius: 12px;
    }

    .pp-intro-title {
        font-size: 1.15em;
        font-weight: 700;
        color: #333;
        margin-bottom: 8px;
    }

    .pp-intro-text {
        font-size: 0.92em;
        color: #555;
        line-height: 1.6;
        margin: 0;
    }

    .pp-intro-legend {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        margin-top: 12px;
        padding-top: 10px;
        border-top: 1px solid #dee2e6;
    }

    .pp-legend-item {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 0.85em;
        color: #666;
    }

    .pp-legend-icon {
        width: 22px;
        height: 22px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        flex-shrink: 0;
    }

    .pp-legend-star {
        background: rgba(255, 193, 7, 0.9);
        color: #fff;
    }

    .pp-legend-approve {
        background: #2196F3;
    }

    .pp-legend-approve-inner {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #fff;
    }

    .pp-legend-delete {
        background: #dc3545;
        color: #fff;
        font-weight: bold;
        font-size: 10px;
    }

    /* ═══ RESZPONZÍV ═══ */
    @@media (max-width: 768px) {
        .pp-gallery-grid {
            grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)) !important;
            gap: 12px !important;
        }

        .pp-intro-legend {
            flex-direction: column;
            gap: 8px;
        }
    }

    @@media (max-width: 480px) {
        .pp-gallery-grid {
            grid-template-columns: repeat(2, 1fr) !important;
            gap: 10px !important;
        }
    }
</style>

@if (Dnn.User.UserID == -1)
{
    <div style="padding:20px; background:#fff3cd; border:1px solid #ffc107; border-radius:8px; text-align:center; margin:10px;">
        <p style="margin:0; font-size:1.1em;">A galéria megtekintéséhez jelentkezz be!</p>
    </div>
}
else
{
    <div style="padding:15px 20px; width:100%; box-sizing:border-box;">

        @* ═══ GLOBÁLIS GALÉRIA ═══ *@
        @if (globalItems.Any())
        {
            <div class="pp-global-section">
                <div class="pp-global-title">★ Globális Galéria</div>
                <div class="pp-gallery-grid" style="display:grid; grid-template-columns:repeat(auto-fill, minmax(180px, 1fr)); gap:18px; position:relative; z-index:1;">
                    @foreach (var gItem in globalItems)
                    {
                        <div class="pp-card">
                            @if (!string.IsNullOrEmpty(gItem.ImagePath))
                            {
                                <div class="pp-card-img-wrap">
                                    <img src="@gItem.ImagePath" alt="@gItem.ItemName" class="pp-card-img" />
                                </div>
                            }
                            else
                            {
                                <div class="pp-card-noimg">🖼️</div>
                            }
                            <div class="pp-card-title">@gItem.ItemName</div>
                        </div>
                    }
                </div>
            </div>
        }

        @* ═══ BEVEZETŐ ═══ *@
        <div class="pp-intro-section">
            <div class="pp-intro-title">📸 Képgaléria</div>
            <p class="pp-intro-text">
                Töltsd fel saját képeidet a galériába! Az adminisztrátor kiválaszthatja a legjobb képeket
                a globális galériába, de ehhez neked is engedélyezned kell a képed megosztását.
                Csak azok a képek jelennek meg a globális galériában, amelyeket az admin kijelölt
                <strong>és</strong> a feltöltő felhasználó is jóváhagyott.
            </p>
            <div class="pp-intro-legend">
                <div class="pp-legend-item">
                    <span class="pp-legend-icon pp-legend-star">★</span>
                    <span>Admin kijelölés a globális galériába</span>
                </div>
                <div class="pp-legend-item">
                    <span class="pp-legend-icon pp-legend-approve"><span class="pp-legend-approve-inner"></span></span>
                    <span>Engedélyezés a globálisba (feltöltő állítja)</span>
                </div>
                <div class="pp-legend-item">
                    <span class="pp-legend-icon pp-legend-delete">✕</span>
                    <span>Kép törlése</span>
                </div>
            </div>
        </div>

        @* ═══ FELTÖLTŐ SÁV ═══ *@
        <div style="background:#f9f9f9; border:1px solid #e0e0e0; border-radius:10px; padding:14px 18px; margin-bottom:24px;">
            <table style="width:100%; border:none; border-collapse:collapse; background:transparent;">
                <tr>
                    <td style="padding:0 10px 0 0; border:none; background:transparent;">
                        <input type="text"
                               id="ppName_@Dnn.ModuleContext.ModuleId"
                               placeholder="Kép neve..."
                               class="pp-name-input" />
                    </td>
                    <td style="padding:0 10px 0 0; border:none; background:transparent; white-space:nowrap;">
                        <input type="file"
                               id="ppFile_@Dnn.ModuleContext.ModuleId"
                               accept="image/*"
                               style="font-size:0.9em;" />
                    </td>
                    <td style="padding:0; border:none; background:transparent; white-space:nowrap; text-align:right;">
                        <button type="button"
                                id="ppUploadBtn_@Dnn.ModuleContext.ModuleId"
                                class="pp-upload-btn">
                            ⬆ Feltöltés
                        </button>
                    </td>
                </tr>
            </table>
            <div id="ppStatus_@Dnn.ModuleContext.ModuleId" style="display:none; margin-top:8px; font-size:0.9em; color:#666;"></div>
        </div>

        @* ═══ SZEMÉLYES GALÉRIA ═══ *@
        <div class="pp-gallery-grid" style="display:grid; grid-template-columns:repeat(auto-fill, minmax(180px, 1fr)); gap:18px; padding-bottom:15px;">

            @if (Model == null || !Model.Any())
            {
                <p style="grid-column:1/-1; text-align:center; color:#999; padding:40px 0;">
                    Még nincs feltöltött képed a galériában.
                </p>
            }
            else
            {
                foreach (var item in Model)
                {
                    <div class="pp-card" id="ppCard_@item.ItemId">
                        @if (!string.IsNullOrEmpty(item.ImagePath))
                        {
                            <div class="pp-card-img-wrap">
                                <img src="@item.ImagePath" alt="@item.ItemName" class="pp-card-img" />
                            </div>
                        }
                        else
                        {
                            <div class="pp-card-noimg">🖼️</div>
                        }

                        @* ── CSILLAG (admin toggle / user+admin readonly) ── *@
                        @if (isAdmin)
                        {
                            <button type="button"
                                    class="pp-star-btn @(item.IsGlobal ? "active" : "")"
                                    onclick="ppToggleStar(@item.ItemId, this)"
                                    title="Globális galériába helyezés">
                                <span class="star-icon">★</span>
                            </button>
                        }
                        else if (item.IsGlobal)
                        {
                            <span class="pp-star-btn active readonly" title="Globális galériában szerepel">
                                <span class="star-icon">★</span>
                            </span>
                        }

                        @* ── USER ENGEDÉLYEZÉS (bal alsó kör) ── *@
                        @{
                            bool isOwner = item.CreatedByUserId == currentUserId;
                        }
                        @if (isOwner && !isAdmin)
                        {
                            @* A kép tulajdonosa (nem admin) – kattinthat *@
                            <button type="button"
                                    class="pp-approve-btn @(item.IsUserApproved ? "active" : "")"
                                    onclick="ppToggleApproval(@item.ItemId, this)"
                                    title="@(item.IsUserApproved ? "Engedélyezve a globálisba" : "Engedélyezés a globális galériába")">
                                <span class="inner-circle"></span>
                            </button>
                        }
                        else if (isAdmin)
                        {
                            @* Admin látja az állapotot, de NEM kattinthat *@
                            <span class="pp-approve-btn @(item.IsUserApproved ? "active" : "") readonly"
                                  title="@(item.IsUserApproved ? "User engedélyezte" : "User még nem engedélyezte")">
                                <span class="inner-circle"></span>
                            </span>
                        }

                        <div class="pp-card-title">@item.ItemName</div>

                        <button type="button"
                                class="pp-del-btn"
                                onclick="ppDel(@item.ItemId, '@Html.Raw(item.ItemName.Replace("'", "\\'"))')">
                            ✕
                        </button>
                    </div>
                }
            }
        </div>
    </div>

    @* ═══ TÖRLÉS MODAL ═══ *@
    <div id="ppDelModal"
         style="display:none; position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,0.5); z-index:99999; align-items:center; justify-content:center;">
        <div style="background:#fff; padding:30px; border-radius:12px; box-shadow:0 5px 30px rgba(0,0,0,0.3); text-align:center; max-width:400px; width:90%;">
            <p style="font-size:1.1em; margin-bottom:5px;"><strong>Törlés megerősítése</strong></p>
            <p>Biztosan törölni szeretnéd?</p>
            <p id="ppDelName" style="font-weight:bold; color:#dc3545;"></p>
            <div style="margin-top:20px; display:flex; gap:10px; justify-content:center;">
                <button type="button" onclick="ppExecDel()" class="pp-modal-yes">Igen, törlöm</button>
                <button type="button" onclick="ppCloseDel()" class="pp-modal-no">Mégse</button>
            </div>
        </div>
    </div>
}

<script type="text/javascript">
    (function ($) {
        var mid = '@Dnn.ModuleContext.ModuleId';
        var sf = $.ServicesFramework(parseInt(mid));
        var delId = null;

        // ═══ FELTÖLTÉS ═══
        $('#ppUploadBtn_' + mid).on('click', function () {
            var nameInput = document.getElementById('ppName_' + mid);
            var fileInput = document.getElementById('ppFile_' + mid);
            var statusDiv = document.getElementById('ppStatus_' + mid);

            var itemName = nameInput.value.trim();
            if (!itemName) {
                alert('Kérlek, add meg a kép nevét!');
                nameInput.focus();
                return;
            }

            if (!fileInput.files || fileInput.files.length === 0) {
                alert('Kérlek, válassz ki egy képet!');
                return;
            }

            var formData = new FormData();
            formData.append('ItemName', itemName);
            formData.append('ModuleId', mid);
            formData.append('file', fileInput.files[0]);

            var apiUrl = sf.getServiceRoot('DNNHello') + 'GalleryApi/Upload';

            statusDiv.style.display = 'block';
            statusDiv.innerText = 'Feltöltés folyamatban...';

            $.ajax({
                url: apiUrl,
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                beforeSend: sf.setModuleHeaders,
                success: function () {
                    statusDiv.innerText = 'Sikeres feltöltés! Oldal frissítése...';
                    location.reload();
                },
                error: function (xhr) {
                    statusDiv.style.color = '#dc3545';
                    statusDiv.innerText = 'Hiba történt a feltöltés során. (' + xhr.status + ')';
                }
            });
        });

        // ═══ CSILLAG TOGGLE (admin – IsGlobal) ═══
        window.ppToggleStar = function (itemId, btn) {
            var apiUrl = sf.getServiceRoot('DNNHello') + 'GalleryApi/ToggleGlobal?itemId=' + itemId;

            $.ajax({
                url: apiUrl,
                type: 'POST',
                beforeSend: sf.setModuleHeaders,
                success: function (data) {
                    if (data.isGlobal) {
                        $(btn).addClass('active');
                    } else {
                        $(btn).removeClass('active');
                    }
                },
                error: function (xhr) {
                    alert('Hiba a csillagozás során. (' + xhr.status + ')');
                }
            });
        };

        // ═══ USER ENGEDÉLYEZÉS TOGGLE (IsUserApproved) ═══
        window.ppToggleApproval = function (itemId, btn) {
            var apiUrl = sf.getServiceRoot('DNNHello') + 'GalleryApi/ToggleUserApproval?itemId=' + itemId;

            $.ajax({
                url: apiUrl,
                type: 'POST',
                beforeSend: sf.setModuleHeaders,
                success: function (data) {
                    if (data.isUserApproved) {
                        $(btn).addClass('active');
                    } else {
                        $(btn).removeClass('active');
                    }
                },
                error: function (xhr) {
                    alert('Hiba az engedélyezés során. (' + xhr.status + ')');
                }
            });
        };

        // ═══ TÖRLÉS ═══
        window.ppDel = function (id, name) {
            delId = id;
            document.getElementById('ppDelName').innerText = '"' + name + '"';
            document.getElementById('ppDelModal').style.display = 'flex';
        };

        window.ppCloseDel = function () {
            delId = null;
            document.getElementById('ppDelModal').style.display = 'none';
        };

        window.ppExecDel = function () {
            if (delId !== null) {
                window.location.href = '@Url.Action("Delete", "Item")' + '?itemId=' + delId;
            }
        };

        $(document).on('keydown', function (e) {
            if (e.key === 'Escape') ppCloseDel();
        });

    }(jQuery));
</script>