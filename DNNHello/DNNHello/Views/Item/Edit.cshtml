@inherits DotNetNuke.Web.Mvc.Framework.DnnWebViewPage<DNNHello.DNNHello.Models.Item>

@using System.Web.Mvc
@using DotNetNuke.Web.Mvc.Helpers

<div id="Item-@Dnn.ModuleContext.ModuleId">
    @* --- MANUÁLIS FORM (Ez nem tud elromlani) --- *@
    <form action="@Url.Action("Edit", "Item")" method="post" enctype="multipart/form-data">

        @Html.AntiForgeryToken()

        @* Fontos: Az ItemId-t és ModuleId-t el kell küldenünk rejtve *@
        <input type="hidden" name="ItemId" value="@Model.ItemId" />
        <input type="hidden" name="ModuleId" value="@Model.ModuleId" />

        <div class="dnnForm dnnEditBasicSettings" id="dnnEditBasicSettings">
            <h2 id="dnnSitePanel-BasicSettings" class="dnnFormSectionHead dnnClear">
                <a href="#" class="dnnSectionExpanded">📸 Kép adatai</a>
            </h2>
            <fieldset>
                <div class="dnnFormItem">
                    <div><label>Kép címe:</label></div>
                    @Html.TextBoxFor(m => m.ItemName)
                </div>

                <div class="dnnFormItem">
                    <div><label>Leírás:</label></div>
                    @Html.TextAreaFor(m => m.ItemDescription)
                </div>

                <div class="dnnFormItem" style="margin-top:20px; padding:15px; background:#f5f5f5; border:1px solid #ddd; border-radius:5px;">
                    <div><label><strong>Kép kiválasztása:</strong></label></div>
                    <input type="file" name="file" id="file" accept="image/*" />

                    @if (Model != null && !string.IsNullOrEmpty(Model.ImagePath))
                    {
                        <div style="margin-top:10px;">
                            <p>Jelenlegi kép:</p>
                            <img src="@Model.ImagePath" style="width:150px; border:1px solid #ccc; border-radius:4px;" />
                            @Html.HiddenFor(m => m.ImagePath)
                        </div>
                    }
                </div>
            </fieldset>
        </div>

        <div style="margin-top:20px; border-top: 1px solid #eee; padding-top: 20px;">
            <button type="submit" class="dnnPrimaryAction">🚀 Feltöltés és Mentés</button>
            <a href="@Url.Action("Index", "Item")" class="dnnSecondaryAction">Mégse</a>
        </div>
    </form>
</div>

@* A DNN panelek animációjához szükséges script *@
<script type="text/javascript">
    (function ($, Sys) {
        $(function () {
            $('#dnnEditBasicSettings').dnnPanels();
        });
    }(jQuery, window.Sys));
</script> 