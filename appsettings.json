{
    "Hotcakes": {
        // Base URL of your DotNetNuke site (trailing slash is fine)
        "BaseUrl": "http://4.231.236.217/",

        // REST API path under the site. Final URL = BaseUrl + ApiBasePath + endpoint
        // Typical Hotcakes Commerce v1 path: DesktopModules/Hotcakes/API/rest/v1/
        // Adjust if your installation uses a different path.
        "ApiBasePath": "DesktopModules/Hotcakes/API/rest/v1/",

        // *** DO NOT COMMIT YOUR REAL API KEY HERE ***
        // This file is tracked in git. The application stores the API key the
        // user enters via the in-app "API beállítások" form in
        //     %APPDATA%\HotcakesWinFormsApp\apisettings.json
        // (outside the project tree), and that location OVERRIDES the value
        // below at runtime. Leave this empty in the repo.
        // The key is generated from: DNN Admin > Hotcakes > Configuration > API
        "ApiKey": ""
    },

  "DemoLogin": {
    // Simple demo credentials (no server authentication - local check only)
    "Username": "admin",
    "Password": "admin123"
  },

  // Set to true to use built-in mock data instead of hitting the live API.
  // Useful for UI demos when the server is unavailable.
  "UseMockData": false

}
